变量 {
    全局:
        0: f
        1: runs
        2: t0
}

规则 ("P2 driver: toggles the flag on a fixed timeline") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        设置全局变量(runs, 0);
        设置全局变量(t0, 总计消耗时间);
        设置全局变量(f, 真);
        等待(0.2, 无视条件);
        设置全局变量(f, 假);
        等待(0.2, 无视条件);
        设置全局变量(f, 真);
        等待(2, 无视条件);
        设置全局变量(f, 假);
        等待(0.2, 无视条件);
        设置全局变量(f, 真);
        等待(3, 无视条件);
        记入查看器(自定义字符串("P2 total runs={0}", 全局.runs, 空, 空));
    }
}

规则 ("P2 target: waits 1 s while the flag toggles") {
    事件 {
        持续 - 全局;
    }
    条件 {
        全局.f == 真;
    }
    动作 {
        修改全局变量(runs, 加, 1);
        记入查看器(自定义字符串("P2 run#{0} start t_ms={1}", 全局.runs, 乘(减(总计消耗时间, 全局.t0), 1000)));
        等待(1, 无视条件);
        记入查看器(自定义字符串("P2 run#{0} end t_ms={1}", 全局.runs, 乘(减(总计消耗时间, 全局.t0), 1000)));
    }
}
