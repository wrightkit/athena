变量 {
    全局:
        0: go
        1: go2
        2: t0
}

规则 ("P3 driver") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        设置全局变量(t0, 总计消耗时间);
        设置全局变量(go, 真);
        等待(1, 无视条件);
        设置全局变量(go2, 真);
        等待(1, 无视条件);
        记入查看器(自定义字符串("P3 done", 空, 空, 空));
    }
}

规则 ("P3 A") {
    事件 {
        持续 - 全局;
    }
    条件 {
        全局.go == 真;
    }
    动作 {
        记入查看器(自定义字符串("P3 first batch rule=A t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
    }
}

