变量 {
    全局:
        0: w
        1: mt
        2: f
        3: mgo
        4: m
        5: k
        6: i
}

规则 ("P8 driver: Wait durations under Set Slow Motion factors 100, 50 and 90") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        设置全局变量(k, 0);
        While(比较(全局.k, <, 3));
            设置全局变量(f, 数组中的值(数组(100, 50, 90), 全局.k));
            设置慢动作(全局.f);
            等待(0.5, 无视条件);
            设置全局变量(mgo, 真);
            等待(0.5, 无视条件);
            设置全局变量(i, 0);
            While(比较(全局.i, <, 4));
                设置全局变量(w, 总计消耗时间);
                等待(数组中的值(数组(0.016, 0.1, 0.5, 1), 全局.i), 无视条件);
                记入查看器(自定义字符串("P8w f={0} wait_ms={1} elapsed_ms={2}", 全局.f, 乘(数组中的值(数组(0.016, 0.1, 0.5, 1), 全局.i), 1000), 乘(减(总计消耗时间, 全局.w), 1000)));
                修改全局变量(i, 加, 1);
            End;
            修改全局变量(k, 加, 1);
        End;
        设置慢动作(100);
        记入查看器(自定义字符串("P8 done", 空, 空, 空));
    }
}

规则 ("P8 metronome: Total Time Elapsed per tick under the active factor") {
    事件 {
        持续 - 全局;
    }
    条件 {
        全局.mgo == 真;
    }
    动作 {
        设置全局变量(mt, 总计消耗时间);
        设置全局变量(m, 0);
        While(比较(全局.m, <, 8));
            等待(0, 无视条件);
            记入查看器(自定义字符串("P8m f={0} i={1} t_ms={2}", 全局.f, 全局.m, 乘(减(总计消耗时间, 全局.mt), 1000)));
            修改全局变量(m, 加, 1);
        End;
        设置全局变量(mgo, 假);
    }
}
