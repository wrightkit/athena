变量 {
    全局:
        0: i
        1: t0
}

规则 ("P0 timer resolution: 8 x Wait(0.016), log Total Time Elapsed") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        设置全局变量(i, 0);
        设置全局变量(t0, 总计消耗时间);
        While(比较(全局.i, <, 8));
            等待(0.016, 无视条件);
            记入查看器(自定义字符串("P0 i={0} t_ms={1}", 全局.i, 乘(减(总计消耗时间, 全局.t0), 1000)));
            修改全局变量(i, 加, 1);
        End;
    }
}
