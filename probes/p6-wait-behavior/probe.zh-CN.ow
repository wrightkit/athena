变量 {
    全局:
        0: f
        1: t0
        2: nIgnore
        3: nAbort
        4: nRestart
        5: endIgnore
        6: endAbort
        7: endRestart
}

规则 ("P6 driver") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        设置全局变量(t0, 总计消耗时间);
        设置全局变量(f, 真);
        记入查看器(自定义字符串("P6 flag=true t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
        等待(0.2, 无视条件);
        设置全局变量(f, 假);
        记入查看器(自定义字符串("P6 flag=false t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
        等待(0.2, 无视条件);
        设置全局变量(f, 真);
        记入查看器(自定义字符串("P6 flag=true t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
        等待(0.2, 无视条件);
        设置全局变量(f, 假);
        记入查看器(自定义字符串("P6 flag=false t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
        等待(2, 无视条件);
        记入查看器(自定义字符串("P6 counts {0} {1}", 自定义字符串("nIgnore={0} nAbort={1} nRestart={2}", 全局.nIgnore, 全局.nAbort, 全局.nRestart), 自定义字符串("endIgnore={0} endRestart={1}", 全局.endIgnore, 全局.endRestart), 空));
        记入查看器(自定义字符串("P6 done t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
    }
}

规则 ("P6 Ignore Condition") {
    事件 {
        持续 - 全局;
    }
    条件 {
        全局.f == 真;
    }
    动作 {
        设置全局变量(nIgnore, 加(全局.nIgnore, 1));
        等待(1, 无视条件);
        设置全局变量(endIgnore, 加(全局.endIgnore, 1));
        记入查看器(自定义字符串("P6 Ignore end t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
    }
}

规则 ("P6 Abort When False") {
    事件 {
        持续 - 全局;
    }
    条件 {
        全局.f == 真;
    }
    动作 {
        设置全局变量(nAbort, 加(全局.nAbort, 1));
        等待(1, 当为“假”时中止);
        设置全局变量(endAbort, 加(全局.endAbort, 1));
        记入查看器(自定义字符串("P6 Abort end t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
    }
}

规则 ("P6 Restart When True") {
    事件 {
        持续 - 全局;
    }
    条件 {
        全局.f == 真;
    }
    动作 {
        设置全局变量(nRestart, 加(全局.nRestart, 1));
        等待(1, 当为“真”时重新开始);
        设置全局变量(endRestart, 加(全局.endRestart, 1));
        记入查看器(自定义字符串("P6 Restart end t_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
    }
}
