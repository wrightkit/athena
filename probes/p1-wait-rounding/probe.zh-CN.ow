变量 {
    全局:
        0: i
        1: t0
}

规则 ("P1 wait rounding: elapsed time for several requested waits") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        设置全局变量(i, 0);
        While(比较(全局.i, <, 6));
            设置全局变量(t0, 总计消耗时间);
            等待(数组中的值(数组(0.001, 0.016, 0.017, 0.03, 0.1, 0.5), 全局.i), 无视条件);
            记入查看器(自定义字符串("P1 requested_ms={0} elapsed_ms={1}", 乘(数组中的值(数组(0.001, 0.016, 0.017, 0.03, 0.1, 0.5), 全局.i), 1000), 乘(减(总计消耗时间, 全局.t0), 1000)));
            修改全局变量(i, 加, 1);
        End;
    }
}
