变量 {
    全局:
        0: i
}

规则 ("P5 Position Of refresh rate: forced forward throttle for 3 s") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        等待直到 (与(已重生(主机玩家), 存活(主机玩家)), 600);
        记入查看器(自定义字符串("P5 start spawned={0} pos={1}", 已重生(主机玩家), 所选位置(主机玩家), 空));
        开始限制阈值 (主机玩家, 1, 1, 0, 0, 0, 0);
        设置全局变量(i, 0);
        While(比较(全局.i, <, 188));
            等待(0.016, 无视条件);
            记入查看器(自定义字符串("P5 i={0} pos={1} everyframe={2}", 全局.i, 所选位置(主机玩家), 逐帧更新(所选位置(主机玩家))));
            修改全局变量(i, 加, 1);
        End;
        停止限制阈值(主机玩家);
    }
}
