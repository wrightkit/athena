设置 {
    模式 {
        突击模式 {
        }
    }

    英雄 {
        综合 {
            启用英雄 {
                安娜
            }
            生命值: 150%
            受到伤害量: 50%
            受到治疗量: 200%
            技能冷却时间: 50%
        }
    }
}

规则 ("P7 hero settings: reported state under scaled pools, damage, heal and cooldown") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        记入查看器(自定义字符串("P7 max_health={0}", 最大生命值(数组中的值(所有玩家(所有队伍), 0)), 空, 空));
        伤害(数组中的值(所有玩家(所有队伍), 0), 空, 200);
        记入查看器(自定义字符串("P7 health_after_damage={0}", 生命值(数组中的值(所有玩家(所有队伍), 0)), 空, 空));
        治疗(数组中的值(所有玩家(所有队伍), 0), 空, 40);
        记入查看器(自定义字符串("P7 health_after_heal={0}", 生命值(数组中的值(所有玩家(所有队伍), 0)), 空, 空));
        设置技能冷却(数组中的值(所有玩家(所有队伍), 0), 按钮(技能1), 20);
        记入查看器(自定义字符串("P7 ability1_cooldown={0}", 技能冷却时间(数组中的值(所有玩家(所有队伍), 0), 按钮(技能1)), 空, 空));
        记入查看器(自定义字符串("P7 done", 空, 空, 空));
    }
}
