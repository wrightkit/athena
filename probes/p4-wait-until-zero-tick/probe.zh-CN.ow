变量 {
    全局:
        0: t0
}

规则 ("P4 Wait Until vs Wait: zero-tick behavior and timeout rounding") {
    事件 {
        持续 - 全局;
    }
    动作 {
        等待(3, 无视条件);
        设置全局变量(t0, 总计消耗时间);
        等待直到 (真, 0);
        记入查看器(自定义字符串("P4a Wait Until(True, 0) elapsed_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
        设置全局变量(t0, 总计消耗时间);
        等待(0, 无视条件);
        记入查看器(自定义字符串("P4b Wait(0) elapsed_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
        设置全局变量(t0, 总计消耗时间);
        等待直到 (假, 0.03);
        记入查看器(自定义字符串("P4c Wait Until(False, 0.03) elapsed_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
        设置全局变量(t0, 总计消耗时间);
        等待直到 (假, 0.1);
        记入查看器(自定义字符串("P4d Wait Until(False, 0.1) elapsed_ms={0}", 乘(减(总计消耗时间, 全局.t0), 1000), 空, 空));
    }
}
