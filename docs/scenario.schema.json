{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wrightkit/athena/blob/main/docs/scenario.schema.json",
  "title": "athena scenario, version 1",
  "type": "object",
  "required": ["scenarioVersion", "seconds", "players"],
  "additionalProperties": false,
  "properties": {
    "scenarioVersion": { "const": 1 },
    "seconds": { "type": "number", "exclusiveMinimum": 0 },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/player" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "expect": {
      "type": "array",
      "items": { "$ref": "#/$defs/expectation" }
    },
    "random": { "$ref": "#/$defs/random" },
    "serverLoad": { "$ref": "#/$defs/serverLoad" },
    "map": {
      "type": "string",
      "minLength": 1,
      "description": "The map Current Map reads: a Map member id of the workshop-rs catalog (for example KINGS_ROW) or its en-US spelling, matched case-insensitively — the same form a player's hero takes. Constant for the run; a Current Map read with no field is a missing input."
    },
    "objectives": {
      "type": "array",
      "items": { "$ref": "#/$defs/position" },
      "description": "The objective positions Objective Position reads: entry i is the position of objective index i — the evaluated argument, a number or a boolean under the number coercion (False/True as 0/1). Supply the field whole or not at all: a read with no field, or an index naming no entry, is a missing input."
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "time": { "type": "number", "minimum": 0 },
    "random": {
      "type": "object",
      "required": ["seed"],
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615,
          "description": "Unsigned 64-bit seed. Write it as an integer literal: the loader rejects a decimal point or exponent, so 1.0 and 1e3 fail although 'integer' admits integral-valued numbers."
        }
      }
    },
    "serverLoad": {
      "type": "object",
      "required": ["average", "peak", "current"],
      "additionalProperties": false,
      "properties": {
        "average": { "type": "number" },
        "peak": { "type": "number" },
        "current": { "type": "number" }
      },
      "description": "The numbers Server Load Average, Server Load Peak and Server Load read, constant for the run. Supply the field whole or not at all: a partial object is malformed, and a read with no field is a missing input."
    },
    "position": {
      "type": "object",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "description": "The player's position the position-reading values return: x left, y up, z forward. Supply it whole or not at all: a partial object is malformed, and a read with no field is a missing input."
    },
    "facing": {
      "type": "object",
      "required": ["horizontal", "vertical"],
      "additionalProperties": false,
      "properties": {
        "horizontal": { "type": "number" },
        "vertical": { "type": "number" }
      },
      "description": "The player's facing the facing-reading values use: horizontal and vertical degrees, horizontal 0 forward (+z) increasing left, vertical 0 level increasing downward. Supply it whole or not at all: a partial object is malformed, and a read with no field is a missing input."
    },
    "value": {
      "type": ["null", "boolean", "number", "string", "array"],
      "items": { "$ref": "#/$defs/value" }
    },
    "values": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "player": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "hero": { "type": "string", "minLength": 1 },
        "team": { "enum": ["team1", "team2"] },
        "host": { "type": "boolean" },
        "state": { "$ref": "#/$defs/values" },
        "buttons": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "position": { "$ref": "#/$defs/position" },
        "facing": { "$ref": "#/$defs/facing" }
      }
    },
    "event": {
      "type": "object",
      "required": ["kind", "time"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "time": { "$ref": "#/$defs/time" },
        "eventPlayer": { "$ref": "#/$defs/id" },
        "values": { "$ref": "#/$defs/values" }
      }
    },
    "expectation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "name", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "global" },
            "name": { "$ref": "#/$defs/id" },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "player", "name", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "playerVariable" },
            "player": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/id" },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "tick", "text"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "log" },
            "tick": { "type": "integer", "minimum": 0 },
            "text": { "type": "string" }
          }
        }
      ]
    }
  }
}
